# ═══════════════════════════════════════════════════════════════
# Apache VHost Manager - Production Configuration
# ═══════════════════════════════════════════════════════════════

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Security - CHANGE THESE VALUES!
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# Logging
VHOST_VERBOSE=0  # 0 = silent (logs to file only), 1 = verbose (logs to console)

# Application
HOST=0.0.0.0
PORT=5000